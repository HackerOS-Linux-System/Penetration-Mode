{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "penetration-mode",
  "mainBinaryName": "penetration-mode-shell",
  "version": "2.5.0",
  "identifier": "com.redteam.penetrationmode",
  "build": {
    "beforeDevCommand": { "cwd": "../frontend", "script": "npm run dev" },
    "beforeBuildCommand": { "cwd": "../frontend", "script": "npm run build" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Penetration Mode // Red Team",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.example-corp.internal/penetration-mode/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_WITH_GENERATED_PUBLIC_KEY"
    }
  }
}
