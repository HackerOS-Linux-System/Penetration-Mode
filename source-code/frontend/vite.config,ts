import { defineConfig } from "vite";
import solid from "vite-plugin-solid";

// Tauri expects a fixed port and needs the dev server to be reachable
// from the wrapping webview. See https://tauri.app/develop/#vite
export default defineConfig(async () => ({
  plugins: [solid()],

  // Prevent vite from obscuring rust errors
  clearScreen: false,

  server: {
    port: 1420,
    strictPort: true,
    host: "0.0.0.0",
    watch: {
      // Tell vite to ignore watching the backend (src-tauri / rust)
      ignored: ["**/source-code/backend/**"],
    },
  },

  envPrefix: ["VITE_", "TAURI_"],

  // Runda 10: jawna konfiguracja Vitest zamiast polegania na niejawnym
  // (i niepewnym co do przyszłych wersji) zachowaniu domyślnym — testy
  // komponentów (@solidjs/testing-library) potrzebują prawdziwego DOM-u
  // (jsdom), nie tylko czystych funkcji jak dotychczasowe testy w lib/.
  test: {
    environment: "jsdom",
    setupFiles: ["./src/test-setup.ts"],
  },

  build: {
    target: process.env.TAURI_ENV_PLATFORM === "windows" ? "chrome105" : "safari13",
    minify: !process.env.TAURI_ENV_DEBUG ? "esbuild" : false,
    sourcemap: !!process.env.TAURI_ENV_DEBUG,
    outDir: "dist",
  },
}));
